# Google Service Account credentials
# Dapatkan dari Google Cloud Console → Service Accounts → Keys → JSON
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Sheet ID (dari URL spreadsheet)
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Drive Folder ID untuk upload gambar
# Buat folder di Drive, klik kanan → Share → copy ID dari URL
DRIVE_FOLDER_ID=your_drive_folder_id_here

# Admin password (untuk proteksi simple)
ADMIN_PASSWORD=your_secure_password_here
